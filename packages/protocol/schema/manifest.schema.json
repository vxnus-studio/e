{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e.vxnuslabs.com/schema/manifest-1.0.json",
  "title": "E Knowledge Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "publisher", "version", "schemaVersion", "sources", "capabilities"],
  "allOf": [{
    "if": { "properties": { "capabilities": { "properties": { "semanticSearch": { "const": true } } } } },
    "then": { "required": ["retrieval"], "properties": { "retrieval": { "required": ["embedding"] } } }
  }],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "schemaVersion": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "description": { "type": "string" },
    "license": { "$ref": "#/$defs/license" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" }, "uniqueItems": true },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "retrieval": { "$ref": "#/$defs/retrieval" }
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "license"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "licenseDescription": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "format": "uri" },
        "uri": { "type": "string", "format": "uri" },
        "publishedAt": { "type": "string", "minLength": 1 }
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["license", "licenseName", "licenseUrl"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "licenseName": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "format": "uri" },
        "rightsHolder": { "type": "string", "minLength": 1 },
        "copyrightNotice": { "type": "string", "minLength": 1 },
        "attributionText": { "type": "string", "minLength": 1 },
        "notice": { "type": "string", "minLength": 1 }
      }
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "embedding": { "type": "object", "additionalProperties": false, "required": ["model", "dimensions", "provider"], "properties": {
          "model": { "type": "string", "minLength": 1 }, "dimensions": { "type": "integer", "minimum": 1 }, "provider": { "type": "string", "minLength": 1 }
        } }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["lexicalSearch", "semanticSearch", "structuredEntities", "relations", "revisions"],
      "properties": {
        "lexicalSearch": { "type": "boolean" }, "semanticSearch": { "type": "boolean" },
        "structuredEntities": { "type": "boolean" }, "relations": { "type": "boolean" },
        "revisions": { "type": "boolean" }
      },
      "allOf": [{
        "if": { "properties": { "relations": { "const": true } } },
        "then": { "properties": { "structuredEntities": { "const": true } } }
      }]
    }
  }
}
