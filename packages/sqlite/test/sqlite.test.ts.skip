import { test, expect, describe, beforeEach, afterEach } from "vitest";
import { SqliteEngine } from "../src/index.js";
import Database from "better-sqlite3";
import type { QueryRequest } from "e";

describe("SqliteEngine", () => {
  let engine: SqliteEngine;
  let db: Database.Database;

  beforeEach(() => {
    // In-memory sqlite db
    engine = new SqliteEngine(":memory:");
    db = (engine as any).db; // access for test setup

    db.exec(`
      INSERT INTO e_entities (id, namespace, kind, slug, name, data)
      VALUES 
      ('e-1', 'test', 'node', 'a', 'A', '{}'),
      ('e-2', 'test', 'node', 'b', 'B', '{}'),
      ('e-3', 'test', 'node', 'c', 'C', '{}');

      INSERT INTO e_aliases (id, entity_id, alias)
      VALUES ('a-1', 'e-1', 'Alpha');

      INSERT INTO e_relations (id, subject_id, predicate, object_id)
      VALUES 
      ('r-1', 'e-1', 'links_to', 'e-2'),
      ('r-2', 'e-3', 'links_to', 'e-2');
    `);
  });

  afterEach(() => {
    engine.close();
  });

  test("Resolve", async () => {
    const res = await engine.query({ type: "resolve", alias: "Alpha" });
    expect(res.entities.length).toBe(1);
    expect(res.entities[0].id).toBe("e-1");
  });

  test("GetEntity", async () => {
    const res = await engine.query({ type: "getEntity", id: "e-2" });
    expect(res.entities.length).toBe(1);
    expect(res.entities[0].name).toBe("B");
  });

  test("FindRelations and Hydration", async () => {
    const res = await engine.query({ type: "findRelations", objectId: "e-2" });
    expect(res.relations.length).toBe(2);
    // hydration
    const ids = res.entities.map((e) => e.id);
    expect(ids).toContain("e-1");
    expect(ids).toContain("e-2");
    expect(ids).toContain("e-3");
  });

  test("Search", async () => {
    const res = await engine.query({ type: "search", query: "A" });
    expect(res.entities.some(e => e.id === "e-1")).toBe(true);
  });
});
