{
  "name": "@vxnus/e-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL adapter and schema for E knowledge graph runtime",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vxnuslabs/e.git",
    "directory": "packages/postgres"
  },
  "bugs": {
    "url": "https://github.com/vxnuslabs/e/issues"
  },
  "homepage": "https://github.com/vxnuslabs/e#readme",
  "keywords": [
    "e",
    "postgres",
    "postgresql",
    "neon",
    "knowledge-graph",
    "adapter"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema.sql": "./schema.sql"
  },
  "files": [
    "dist",
    "schema.sql",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pg": "^8.11.3"
  },
  "peerDependencies": {
    "@vxnus/e": "^0.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.10.2",
    "@vxnus/e": "*",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}

