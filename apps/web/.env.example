# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase publisher control plane (server-only)
# Copy the value from NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Enable after the Supabase Auth session adapter is active.
SUPABASE_AUTH_ENABLED=false

# Immutable pack artifacts (Cloudflare R2 / S3-compatible API)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://knowledge.e.vxnus.xyz
