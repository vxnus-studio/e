# Registry metadata (Neon Postgres)
NEON_DATABASE_URL=

# Current hosted Hub origin
HUB_PUBLIC_BASE_URL=https://e.vxnus.xyz

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_COOKIE_DOMAIN=

# Immutable pack artifacts (Cloudflare R2 / S3-compatible API)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://knowledge.e.vxnus.xyz

# Use static for offline development; use neon for the configured Hub.
HUB_REGISTRY_MODE=neon
